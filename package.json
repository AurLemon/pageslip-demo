{
	"name": "pageslip-demo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.5.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"start": "node --env-file-if-exists=.env dist/server.js",
		"lint": "eslint src",
		"format": "prettier --write src package.json tsconfig.json eslint.config.js .prettierrc.json"
	},
	"dependencies": {
		"mysql2": "^3.24.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.19.2",
		"eslint": "^10.15.0",
		"prettier": "^3.10.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0"
	}
}
